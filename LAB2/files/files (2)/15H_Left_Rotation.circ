<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif bold 16"/>
    <comp lib="6" loc="(340,50)" name="Text">
      <a name="text" val="Exercise 15H: 8-bit Left Rotation"/>
    </comp>
    <comp lib="0" loc="(100,200)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="Data [8-bit]"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="0" loc="(100,300)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="Amount [3-bit]"/>
      <a name="width" val="3"/>
    </comp>
    <comp lib="3" loc="(360,240)" name="Shifter">
      <a name="width" val="8"/>
      <a name="shift" val="1r"/>
    </comp>
    <wire from="(100,200)" to="(270,200)"/>
    <wire from="(270,200)" to="(270,230)"/>
    <wire from="(270,230)" to="(320,230)"/>
    <wire from="(100,300)" to="(270,300)"/>
    <wire from="(270,250)" to="(270,300)"/>
    <wire from="(270,250)" to="(320,250)"/>
    <wire from="(360,240)" to="(500,240)"/>
    <comp lib="0" loc="(500,240)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Rotated [8-bit]"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="6" loc="(340,370)" name="Text">
      <a name="text" val="Bits shifted left wrap around to the right side"/>
    </comp>
    <comp lib="6" loc="(340,390)" name="Text">
      <a name="text" val="e.g. 10000001 rotated left by 2 = 00000110"/>
    </comp>
  </circuit>
</project>
