<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif bold 16"/>
    <comp lib="6" loc="(310,60)" name="Text">
      <a name="text" val="Exercise 1M: SR Flip-Flop (NOR gates)"/>
    </comp>
    <comp lib="0" loc="(100,190)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="S (Set)"/>
    </comp>
    <comp lib="0" loc="(100,330)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="R (Reset)"/>
    </comp>
    <comp lib="1" loc="(300,200)" name="NOR Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(300,320)" name="NOR Gate">
      <a name="size" val="30"/>
    </comp>
    <wire from="(100,190)" to="(270,190)"/>
    <wire from="(100,330)" to="(270,330)"/>
    <wire from="(300,200)" to="(440,200)"/>
    <wire from="(300,320)" to="(440,320)"/>
    <wire from="(340,200)" to="(340,270)"/>
    <wire from="(240,270)" to="(340,270)"/>
    <wire from="(240,270)" to="(240,310)"/>
    <wire from="(240,310)" to="(270,310)"/>
    <wire from="(360,320)" to="(360,250)"/>
    <wire from="(250,250)" to="(360,250)"/>
    <wire from="(250,210)" to="(250,250)"/>
    <wire from="(250,210)" to="(270,210)"/>
    <comp lib="0" loc="(440,200)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Q"/>
    </comp>
    <comp lib="0" loc="(440,320)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Q_bar"/>
    </comp>
  </circuit>
</project>
