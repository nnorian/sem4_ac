    <wire from="(80,200)" to="(200,200)"/>
    <comp lib="4" loc="(200,200)" name="D Flip-Flop"/>
    <wire from="(230,200)" to="(330,200)"/>
    <comp lib="4" loc="(330,200)" name="D Flip-Flop"/>
    <wire from="(360,200)" to="(460,200)"/>
