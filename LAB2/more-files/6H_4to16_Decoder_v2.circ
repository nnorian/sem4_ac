<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.16.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif bold 16"/>

    <comp lib="6" loc="(350,40)" name="Text">
      <a name="text" val="Exercise 6H: 4-to-16 Decoder"/>
    </comp>
    <comp lib="6" loc="(350,60)" name="Text">
      <a name="text" val="One-hot output: exactly one Y is high for each input value"/>
    </comp>

    <!-- 4-bit input pin -->
    <comp lib="0" loc="(80,370)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="A[3:0]"/>
      <a name="width" val="4"/>
    </comp>

    <!-- Decoder with disabled=ZERO to skip enable pin -->
    <comp lib="2" loc="(220,370)" name="Decoder">
      <a name="select" val="4"/>
      <a name="disabled" val="ZERO"/>
    </comp>

    <!-- Wire input to decoder select -->
    <wire from="(80,370)" to="(220,370)"/>

    <!-- Output pins Y0-Y15 -->
    <!-- Decoder loc=(220,370), facing east, select=4 -->
    <!-- Outputs on east side, 16 outputs spaced 10px, starting at y=210 up to y=370 -->
    <!-- Output x = 220 + 40 = 260 -->
    <comp lib="0" loc="(380,210)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y0"/>
    </comp>
    <comp lib="0" loc="(380,220)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y1"/>
    </comp>
    <comp lib="0" loc="(380,230)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y2"/>
    </comp>
    <comp lib="0" loc="(380,240)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y3"/>
    </comp>
    <comp lib="0" loc="(380,250)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y4"/>
    </comp>
    <comp lib="0" loc="(380,260)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y5"/>
    </comp>
    <comp lib="0" loc="(380,270)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y6"/>
    </comp>
    <comp lib="0" loc="(380,280)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y7"/>
    </comp>
    <comp lib="0" loc="(380,290)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y8"/>
    </comp>
    <comp lib="0" loc="(380,300)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y9"/>
    </comp>
    <comp lib="0" loc="(380,310)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y10"/>
    </comp>
    <comp lib="0" loc="(380,320)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y11"/>
    </comp>
    <comp lib="0" loc="(380,330)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y12"/>
    </comp>
    <comp lib="0" loc="(380,340)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y13"/>
    </comp>
    <comp lib="0" loc="(380,350)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y14"/>
    </comp>
    <comp lib="0" loc="(380,360)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y15"/>
    </comp>

    <wire from="(260,210)" to="(380,210)"/>
    <wire from="(260,220)" to="(380,220)"/>
    <wire from="(260,230)" to="(380,230)"/>
    <wire from="(260,240)" to="(380,240)"/>
    <wire from="(260,250)" to="(380,250)"/>
    <wire from="(260,260)" to="(380,260)"/>
    <wire from="(260,270)" to="(380,270)"/>
    <wire from="(260,280)" to="(380,280)"/>
    <wire from="(260,290)" to="(380,290)"/>
    <wire from="(260,300)" to="(380,300)"/>
    <wire from="(260,310)" to="(380,310)"/>
    <wire from="(260,320)" to="(380,320)"/>
    <wire from="(260,330)" to="(380,330)"/>
    <wire from="(260,340)" to="(380,340)"/>
    <wire from="(260,350)" to="(380,350)"/>
    <wire from="(260,360)" to="(380,360)"/>
  </circuit>
</project>
