<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.16.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif bold 16"/>

    <comp lib="6" loc="(300,40)" name="Text">
      <a name="text" val="Exercise 16H: 8-bit Bitwise Negation"/>
    </comp>
    <comp lib="6" loc="(300,60)" name="Text">
      <a name="text" val="Out[i] = NOT(In[i])"/>
    </comp>

    <!-- In7 = 1 (Constant) -->
    <comp lib="0" loc="(80,120)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="6" loc="(50,120)" name="Text"><a name="text" val="In7"/></comp>

    <!-- In6 = 0 (Pin) -->
    <comp lib="0" loc="(80,160)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="In6"/>
    </comp>

    <!-- In5 = 1 (Constant) -->
    <comp lib="0" loc="(80,200)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="6" loc="(50,200)" name="Text"><a name="text" val="In5"/></comp>

    <!-- In4 = 0 (Pin) -->
    <comp lib="0" loc="(80,240)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="In4"/>
    </comp>

    <!-- In3 = 1 (Constant) -->
    <comp lib="0" loc="(80,280)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="6" loc="(50,280)" name="Text"><a name="text" val="In3"/></comp>

    <!-- In2 = 0 (Pin) -->
    <comp lib="0" loc="(80,320)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="In2"/>
    </comp>

    <!-- In1 = 1 (Constant) -->
    <comp lib="0" loc="(80,360)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="6" loc="(50,360)" name="Text"><a name="text" val="In1"/></comp>

    <!-- In0 = 0 (Pin) -->
    <comp lib="0" loc="(80,400)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="In0"/>
    </comp>

    <!-- NOT gates -->
    <comp lib="1" loc="(280,120)" name="NOT Gate"><a name="size" val="30"/></comp>
    <comp lib="1" loc="(280,160)" name="NOT Gate"><a name="size" val="30"/></comp>
    <comp lib="1" loc="(280,200)" name="NOT Gate"><a name="size" val="30"/></comp>
    <comp lib="1" loc="(280,240)" name="NOT Gate"><a name="size" val="30"/></comp>
    <comp lib="1" loc="(280,280)" name="NOT Gate"><a name="size" val="30"/></comp>
    <comp lib="1" loc="(280,320)" name="NOT Gate"><a name="size" val="30"/></comp>
    <comp lib="1" loc="(280,360)" name="NOT Gate"><a name="size" val="30"/></comp>
    <comp lib="1" loc="(280,400)" name="NOT Gate"><a name="size" val="30"/></comp>

    <!-- Output pins -->
    <comp lib="0" loc="(480,120)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out7"/>
    </comp>
    <comp lib="0" loc="(480,160)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out6"/>
    </comp>
    <comp lib="0" loc="(480,200)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out5"/>
    </comp>
    <comp lib="0" loc="(480,240)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out4"/>
    </comp>
    <comp lib="0" loc="(480,280)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out3"/>
    </comp>
    <comp lib="0" loc="(480,320)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out2"/>
    </comp>
    <comp lib="0" loc="(480,360)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out1"/>
    </comp>
    <comp lib="0" loc="(480,400)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out0"/>
    </comp>

    <!-- Wires input -> NOT -->
    <wire from="(80,120)" to="(250,120)"/>
    <wire from="(80,160)" to="(250,160)"/>
    <wire from="(80,200)" to="(250,200)"/>
    <wire from="(80,240)" to="(250,240)"/>
    <wire from="(80,280)" to="(250,280)"/>
    <wire from="(80,320)" to="(250,320)"/>
    <wire from="(80,360)" to="(250,360)"/>
    <wire from="(80,400)" to="(250,400)"/>

    <!-- Wires NOT -> output -->
    <wire from="(280,120)" to="(480,120)"/>
    <wire from="(280,160)" to="(480,160)"/>
    <wire from="(280,200)" to="(480,200)"/>
    <wire from="(280,240)" to="(480,240)"/>
    <wire from="(280,280)" to="(480,280)"/>
    <wire from="(280,320)" to="(480,320)"/>
    <wire from="(280,360)" to="(480,360)"/>
    <wire from="(280,400)" to="(480,400)"/>
  </circuit>
</project>
