<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif bold 16"/>
    <comp lib="6" loc="(360,40)" name="Text">
      <a name="text" val="Exercise 8H: 8-bit Full Adder"/>
    </comp>
    <comp lib="0" loc="(80,200)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="A_8bit"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="0" loc="(80,280)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="B_8bit"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="0" loc="(80,380)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="Carry_In"/>
    </comp>
    <wire from="(80,200)" to="(260,200)"/>
    <wire from="(260,200)" to="(260,230)"/>
    <wire from="(260,230)" to="(340,230)"/>
    <wire from="(80,280)" to="(260,280)"/>
    <wire from="(260,250)" to="(260,280)"/>
    <wire from="(260,250)" to="(340,250)"/>
    <comp lib="3" loc="(380,240)" name="Adder"><a name="width" val="8"/></comp>
    <wire from="(80,380)" to="(360,380)"/>
    <wire from="(360,260)" to="(360,380)"/>
    <wire from="(380,230)" to="(540,230)"/>
    <comp lib="0" loc="(540,230)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Sum"/>
      <a name="width" val="8"/>
    </comp>
    <wire from="(380,250)" to="(540,250)"/>
    <comp lib="0" loc="(540,250)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Carry_Out"/>
    </comp>
  </circuit>
</project>
