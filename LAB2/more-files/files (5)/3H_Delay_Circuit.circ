<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif bold 16"/>
    <comp lib="6" loc="(400,40)" name="Text">
      <a name="text" val="Exercise 3H: 4-Clock-Cycle Delay Line"/>
    </comp>
    <comp lib="6" loc="(400,60)" name="Text">
      <a name="text" val="4 D flip-flops in series sharing one clock"/>
    </comp>
    <comp lib="0" loc="(80,200)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="Data_In"/>
    </comp>
    <comp lib="0" loc="(80,340)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="CLK"/>
    </comp>
    <wire from="(80,200)" to="(200,200)"/>
    <comp lib="4" loc="(200,200)" name="D Flip-Flop"/>
    <wire from="(230,200)" to="(340,200)"/>
    <comp lib="4" loc="(340,200)" name="D Flip-Flop"/>
    <wire from="(370,200)" to="(480,200)"/>
    <comp lib="4" loc="(480,200)" name="D Flip-Flop"/>
    <wire from="(510,200)" to="(620,200)"/>
    <comp lib="4" loc="(620,200)" name="D Flip-Flop"/>
    <wire from="(650,200)" to="(760,200)"/>
    <comp lib="0" loc="(760,200)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Delayed_Out"/>
    </comp>
    <wire from="(80,340)" to="(620,340)"/>
    <wire from="(200,220)" to="(200,340)"/>
    <wire from="(340,220)" to="(340,340)"/>
    <wire from="(480,220)" to="(480,340)"/>
    <wire from="(620,220)" to="(620,340)"/>
  </circuit>
</project>
