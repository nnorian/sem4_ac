<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif bold 16"/>
    <comp lib="6" loc="(360,30)" name="Text">
      <a name="text" val="Exercise 18H: 8-bit Binary to Decimal Display"/>
    </comp>
    <comp lib="6" loc="(360,50)" name="Text">
      <a name="text" val="Splits 8-bit input into two 4-bit nibbles for display"/>
    </comp>
    <comp lib="0" loc="(80,200)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="Input_8bit"/>
      <a name="width" val="8"/>
    </comp>
    <wire from="(80,200)" to="(200,200)"/>
    <comp lib="0" loc="(200,200)" name="Splitter">
      <a name="incoming" val="8"/>
      <a name="fanout" val="2"/>
      <a name="bit0" val="0"/>
      <a name="bit1" val="0"/>
      <a name="bit2" val="0"/>
      <a name="bit3" val="0"/>
      <a name="bit4" val="1"/>
      <a name="bit5" val="1"/>
      <a name="bit6" val="1"/>
      <a name="bit7" val="1"/>
    </comp>
    <wire from="(220,210)" to="(300,210)"/>
    <wire from="(300,210)" to="(300,330)"/>
    <comp lib="5" loc="(300,290)" name="Hex Digit Display"/>
    <comp lib="6" loc="(300,360)" name="Text">
      <a name="text" val="High Nibble"/>
    </comp>
    <wire from="(220,190)" to="(440,190)"/>
    <wire from="(440,190)" to="(440,330)"/>
    <comp lib="5" loc="(440,290)" name="Hex Digit Display"/>
    <comp lib="6" loc="(440,360)" name="Text">
      <a name="text" val="Low Nibble"/>
    </comp>
  </circuit>
</project>
