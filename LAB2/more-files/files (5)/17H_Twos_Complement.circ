<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif bold 16"/>
    <comp lib="6" loc="(370,40)" name="Text">
      <a name="text" val="Exercise 17H: 8-bit Twos Complement"/>
    </comp>
    <comp lib="6" loc="(370,60)" name="Text">
      <a name="text" val="Result = NOT(Input) + 1"/>
    </comp>
    <comp lib="0" loc="(80,230)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="Input"/>
      <a name="width" val="8"/>
    </comp>
    <wire from="(80,230)" to="(170,230)"/>
    <comp lib="1" loc="(200,230)" name="NOT Gate"><a name="size" val="30"/><a name="width" val="8"/></comp>
    <wire from="(200,230)" to="(340,230)"/>
    <comp lib="3" loc="(380,240)" name="Adder"><a name="width" val="8"/></comp>
    <comp lib="0" loc="(300,250)" name="Constant"><a name="width" val="8"/><a name="value" val="0x1"/></comp>
    <wire from="(300,250)" to="(340,250)"/>
    <wire from="(380,230)" to="(540,230)"/>
    <comp lib="0" loc="(540,230)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Result"/>
      <a name="width" val="8"/>
    </comp>
    <wire from="(380,250)" to="(540,250)"/>
    <comp lib="0" loc="(540,250)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Overflow"/>
    </comp>
  </circuit>
</project>
