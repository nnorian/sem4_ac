<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif bold 16"/>
    <comp lib="6" loc="(330,50)" name="Text">
      <a name="text" val="Exercise 1M: SR Flip-Flop (cross-coupled NOR gates)"/>
    </comp>
    <comp lib="0" loc="(100,180)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="S"/>
    </comp>
    <comp lib="0" loc="(100,320)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="R"/>
    </comp>
    <comp lib="1" loc="(310,190)" name="NOR Gate"><a name="size" val="30"/></comp>
    <comp lib="1" loc="(310,310)" name="NOR Gate"><a name="size" val="30"/></comp>
    <wire from="(100,180)" to="(280,180)"/>
    <wire from="(100,320)" to="(280,320)"/>
    <wire from="(310,190)" to="(460,190)"/>
    <comp lib="0" loc="(460,190)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Q"/>
    </comp>
    <wire from="(310,310)" to="(460,310)"/>
    <comp lib="0" loc="(460,310)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Qbar"/>
    </comp>
    <wire from="(310,190)" to="(340,190)"/>
    <wire from="(340,190)" to="(340,250)"/>
    <wire from="(250,250)" to="(340,250)"/>
    <wire from="(250,250)" to="(250,300)"/>
    <wire from="(250,300)" to="(280,300)"/>
    <wire from="(310,310)" to="(360,310)"/>
    <wire from="(360,240)" to="(360,310)"/>
    <wire from="(240,240)" to="(360,240)"/>
    <wire from="(240,200)" to="(240,240)"/>
    <wire from="(240,200)" to="(280,200)"/>
  </circuit>
</project>
