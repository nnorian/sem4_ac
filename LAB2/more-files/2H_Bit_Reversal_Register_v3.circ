<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.16.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif bold 16"/>
    <comp lib="6" loc="(330,40)" name="Text">
      <a name="text" val="Exercise 2H: 8-bit Bit Reversal"/>
    </comp>
    <comp lib="6" loc="(330,60)" name="Text">
      <a name="text" val="In[i] maps to Out[7-i]"/>
    </comp>

    <!-- In7 = 1 (Constant) -> Out0, same row y=120, straight wire -->
    <comp lib="0" loc="(80,120)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="6" loc="(55,120)" name="Text"><a name="text" val="In7"/></comp>

    <!-- In6 = 0 (Pin) -> Out1, y=160 -->
    <comp lib="0" loc="(80,160)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="In6"/>
    </comp>

    <!-- In5 = 1 (Constant) -> Out2, y=200 -->
    <comp lib="0" loc="(80,200)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="6" loc="(55,200)" name="Text"><a name="text" val="In5"/></comp>

    <!-- In4 = 0 (Pin) -> Out3, y=240 -->
    <comp lib="0" loc="(80,240)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="In4"/>
    </comp>

    <!-- In3 = 1 (Constant) -> Out4, y=280 -->
    <comp lib="0" loc="(80,280)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="6" loc="(55,280)" name="Text"><a name="text" val="In3"/></comp>

    <!-- In2 = 0 (Pin) -> Out5, y=320 -->
    <comp lib="0" loc="(80,320)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="In2"/>
    </comp>

    <!-- In1 = 1 (Constant) -> Out6, y=360 -->
    <comp lib="0" loc="(80,360)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="6" loc="(55,360)" name="Text"><a name="text" val="In1"/></comp>

    <!-- In0 = 0 (Pin) -> Out7, y=400 -->
    <comp lib="0" loc="(80,400)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="In0"/>
    </comp>

    <!-- Output pins -->
    <comp lib="0" loc="(560,120)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out0"/>
    </comp>
    <comp lib="0" loc="(560,160)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out1"/>
    </comp>
    <comp lib="0" loc="(560,200)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out2"/>
    </comp>
    <comp lib="0" loc="(560,240)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out3"/>
    </comp>
    <comp lib="0" loc="(560,280)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out4"/>
    </comp>
    <comp lib="0" loc="(560,320)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out5"/>
    </comp>
    <comp lib="0" loc="(560,360)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out6"/>
    </comp>
    <comp lib="0" loc="(560,400)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out7"/>
    </comp>

    <!-- Straight horizontal wires, no crossings -->
    <wire from="(80,120)" to="(560,120)"/>
    <wire from="(80,160)" to="(560,160)"/>
    <wire from="(80,200)" to="(560,200)"/>
    <wire from="(80,240)" to="(560,240)"/>
    <wire from="(80,280)" to="(560,280)"/>
    <wire from="(80,320)" to="(560,320)"/>
    <wire from="(80,360)" to="(560,360)"/>
    <wire from="(80,400)" to="(560,400)"/>
  </circuit>
</project>
