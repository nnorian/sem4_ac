<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.16.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif bold 16"/>
    <comp lib="6" loc="(330,40)" name="Text">
      <a name="text" val="Exercise 2H: 8-bit Bit Reversal"/>
    </comp>
    <comp lib="6" loc="(330,60)" name="Text">
      <a name="text" val="In[i] maps to Out[7-i]"/>
    </comp>

    <!-- In7 = 1 constant, routes to Out0 via tunnel -->
    <comp lib="0" loc="(80,120)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="6" loc="(50,120)" name="Text"><a name="text" val="In7"/></comp>
    <comp lib="0" loc="(110,120)" name="Tunnel">
      <a name="label" val="B7"/>
    </comp>

    <!-- In6 = 0 pin -->
    <comp lib="0" loc="(80,160)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="In6"/>
    </comp>
    <comp lib="0" loc="(110,160)" name="Tunnel">
      <a name="label" val="B6"/>
    </comp>

    <!-- In5 = 1 constant -->
    <comp lib="0" loc="(80,200)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="6" loc="(50,200)" name="Text"><a name="text" val="In5"/></comp>
    <comp lib="0" loc="(110,200)" name="Tunnel">
      <a name="label" val="B5"/>
    </comp>

    <!-- In4 = 0 pin -->
    <comp lib="0" loc="(80,240)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="In4"/>
    </comp>
    <comp lib="0" loc="(110,240)" name="Tunnel">
      <a name="label" val="B4"/>
    </comp>

    <!-- In3 = 1 constant -->
    <comp lib="0" loc="(80,280)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="6" loc="(50,280)" name="Text"><a name="text" val="In3"/></comp>
    <comp lib="0" loc="(110,280)" name="Tunnel">
      <a name="label" val="B3"/>
    </comp>

    <!-- In2 = 0 pin -->
    <comp lib="0" loc="(80,320)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="In2"/>
    </comp>
    <comp lib="0" loc="(110,320)" name="Tunnel">
      <a name="label" val="B2"/>
    </comp>

    <!-- In1 = 1 constant -->
    <comp lib="0" loc="(80,360)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="6" loc="(50,360)" name="Text"><a name="text" val="In1"/></comp>
    <comp lib="0" loc="(110,360)" name="Tunnel">
      <a name="label" val="B1"/>
    </comp>

    <!-- In0 = 0 pin -->
    <comp lib="0" loc="(80,400)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="In0"/>
    </comp>
    <comp lib="0" loc="(110,400)" name="Tunnel">
      <a name="label" val="B0"/>
    </comp>

    <!-- Output tunnels - reversed order -->
    <comp lib="0" loc="(490,120)" name="Tunnel">
      <a name="facing" val="west"/>
      <a name="label" val="B0"/>
    </comp>
    <comp lib="0" loc="(490,160)" name="Tunnel">
      <a name="facing" val="west"/>
      <a name="label" val="B1"/>
    </comp>
    <comp lib="0" loc="(490,200)" name="Tunnel">
      <a name="facing" val="west"/>
      <a name="label" val="B2"/>
    </comp>
    <comp lib="0" loc="(490,240)" name="Tunnel">
      <a name="facing" val="west"/>
      <a name="label" val="B3"/>
    </comp>
    <comp lib="0" loc="(490,280)" name="Tunnel">
      <a name="facing" val="west"/>
      <a name="label" val="B4"/>
    </comp>
    <comp lib="0" loc="(490,320)" name="Tunnel">
      <a name="facing" val="west"/>
      <a name="label" val="B5"/>
    </comp>
    <comp lib="0" loc="(490,360)" name="Tunnel">
      <a name="facing" val="west"/>
      <a name="label" val="B6"/>
    </comp>
    <comp lib="0" loc="(490,400)" name="Tunnel">
      <a name="facing" val="west"/>
      <a name="label" val="B7"/>
    </comp>

    <!-- Output pins -->
    <comp lib="0" loc="(560,120)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out0"/>
    </comp>
    <comp lib="0" loc="(560,160)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out1"/>
    </comp>
    <comp lib="0" loc="(560,200)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out2"/>
    </comp>
    <comp lib="0" loc="(560,240)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out3"/>
    </comp>
    <comp lib="0" loc="(560,280)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out4"/>
    </comp>
    <comp lib="0" loc="(560,320)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out5"/>
    </comp>
    <comp lib="0" loc="(560,360)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out6"/>
    </comp>
    <comp lib="0" loc="(560,400)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Out7"/>
    </comp>

    <!-- Input side wires -->
    <wire from="(80,120)" to="(110,120)"/>
    <wire from="(80,160)" to="(110,160)"/>
    <wire from="(80,200)" to="(110,200)"/>
    <wire from="(80,240)" to="(110,240)"/>
    <wire from="(80,280)" to="(110,280)"/>
    <wire from="(80,320)" to="(110,320)"/>
    <wire from="(80,360)" to="(110,360)"/>
    <wire from="(80,400)" to="(110,400)"/>

    <!-- Output side wires -->
    <wire from="(490,120)" to="(560,120)"/>
    <wire from="(490,160)" to="(560,160)"/>
    <wire from="(490,200)" to="(560,200)"/>
    <wire from="(490,240)" to="(560,240)"/>
    <wire from="(490,280)" to="(560,280)"/>
    <wire from="(490,320)" to="(560,320)"/>
    <wire from="(490,360)" to="(560,360)"/>
    <wire from="(490,400)" to="(560,400)"/>
  </circuit>
</project>
